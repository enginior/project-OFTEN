# Copy to .env and adjust. Never commit the real .env.

# Local development: docker compose up -d, then use the URL below.
# Production (Vercel): set this to the Neon/Supabase pooled connection string.
DATABASE_URL="postgres://hephaestus:hephaestus@localhost:5433/hephaestus"

# Public base URL used for canonical URLs, Open Graph, and the sitemap.
# Development default below; set to the production domain on Vercel.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin session signing key (HS256 JWT). REQUIRED in all environments.
# Generate with: openssl rand -base64 32  (must be >= 32 characters)
AUTH_SECRET="replace-with-openssl-rand-base64-32-output"
